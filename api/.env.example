# SOLO EN EL VPS. No guardar secretos en GitHub.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@db:5432/NOMBRE_BBDD
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_API_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Identificadores de objeto (oid) de administradores Entra autorizados, separados por comas.
ADMIN_OIDS=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PORT=8000

# Alternativa preferente: acceso Google + correos individuales (solo VPS).
GOOGLE_CLIENT_ID=client-id.apps.googleusercontent.com
SESSION_SECRET=SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
ADMIN_BOOTSTRAP_EMAILS=admin@empresa.es
PUBLIC_APP_ORIGIN=https://TU_DOMINIO_WEB
COOKIE_SECURE=true

# Opcional: códigos de 6 dígitos para cuentas concretas sin Google.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
