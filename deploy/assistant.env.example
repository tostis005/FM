# Añadir SOLO en /opt/farmawao/.env. No copiar secretos a Git.
# Al activar IA revisar previamente memoria disponible y almacenamiento.
AI_ENABLED=true
AI_MODEL=qwen3:0.6b
# Cupo amplio para el piloto de chat: 100 preguntas cada 10 minutos.
AI_RATE_LIMIT_PER_10M=100
# Activar después de descargar ggml-base.bin y arrancar el contenedor whisper.
AI_VOICE_ENABLED=false
