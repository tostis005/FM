-- Para cada clave unificada, preferir nombre/tipo más frecuente en las filas actuales.
WITH names AS (
 SELECT clave_unificada,nombre_unificado,clase,
        count(*) FILTER (WHERE vigencia='ACTUAL') AS actuales,count(*) AS total
 FROM fm_proveedores_excel GROUP BY 1,2,3
), ranked AS (
 SELECT *,row_number() OVER (PARTITION BY clave_unificada
 ORDER BY actuales DESC,total DESC,nombre_unificado,clase) AS rn FROM names
)
INSERT INTO farmetrica.proveedores_unificados(cliente_slug,clave_unificada,nombre,clase)
SELECT :'cliente_slug','EXCEL:'||clave_unificada,nombre_unificado,clase
FROM ranked WHERE rn=1
ON CONFLICT(cliente_slug,clave_unificada) DO NOTHING;

WITH ranked AS (
 SELECT *,row_number() OVER (PARTITION BY upper(btrim(farmacia_codigo)),btrim(codigo_origen)
 ORDER BY (vigencia='ACTUAL') DESC,clave_unificada,nombre_origen) AS rn
 FROM fm_proveedores_excel
)
INSERT INTO farmetrica.proveedores_unificados_alias
(cliente_slug,proveedor_id,farmacia_codigo,codigo_origen,nombre_origen,procedencia,vigencia)
SELECT :'cliente_slug',p.id,upper(btrim(r.farmacia_codigo)),btrim(r.codigo_origen),
 r.nombre_origen,'excel',r.vigencia
FROM ranked r JOIN farmetrica.proveedores_unificados p ON p.cliente_slug=:'cliente_slug'
 AND p.clave_unificada='EXCEL:'||r.clave_unificada
WHERE r.rn=1 AND NOT EXISTS (
 SELECT 1 FROM fm_proveedores_excel conflict
 WHERE upper(btrim(conflict.farmacia_codigo))=upper(btrim(r.farmacia_codigo))
 AND btrim(conflict.codigo_origen)=btrim(r.codigo_origen)
 AND conflict.clave_unificada<>r.clave_unificada
)
ON CONFLICT(cliente_slug,farmacia_codigo,codigo_origen) DO NOTHING;

-- Conflictos de asignación por un mismo código ERP: revisar antes de modificar manualmente.
SELECT farmacia_codigo,codigo_origen,
 string_agg(DISTINCT clave_unificada||' ('||vigencia||')',', ') AS destinos
FROM fm_proveedores_excel GROUP BY 1,2
HAVING count(DISTINCT clave_unificada)>1;
-- Diferencias de nombre/clase dentro de una clave de destino.
SELECT clave_unificada,count(DISTINCT nombre_unificado) AS nombres,
 count(DISTINCT clase) AS clases
FROM fm_proveedores_excel GROUP BY 1
HAVING count(DISTINCT nombre_unificado)>1 OR count(DISTINCT clase)>1;
COMMIT;